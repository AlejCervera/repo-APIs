{"openapi":"3.1.0","info":{"title":"API Key Auth","version":"0.1.0"},"paths":{"/register":{"post":{"summary":"Register","description":"Register a new user and return their API key (ONCE).","operationId":"register_register_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UserCreate"}}},"required":true},"responses":{"201":{"description":"Successful Response","content":{"application/json":{"schema":{"additionalProperties":{"type":"string"},"type":"object","title":"Response Register Register Post"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api-key/rotate":{"post":{"summary":"Rotate Api Key","description":"Issue a new API key and invalidate the old one. Protected by Basic Auth.\n\nUse it if you lost your key, if it leaked, or as routine rotation.\nThe server cannot \"recover\" a key: it only has its hash.","operationId":"rotate_api_key_api_key_rotate_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"additionalProperties":{"type":"string"},"type":"object","title":"Response Rotate Api Key Api Key Rotate Post"}}}}},"security":[{"HTTPBasic":[]}]}},"/api-key":{"delete":{"summary":"Revoke Api Key","description":"Revoke the current API key without issuing a new one. Protected by Basic Auth.","operationId":"revoke_api_key_api_key_delete","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"additionalProperties":{"type":"string"},"type":"object","title":"Response Revoke Api Key Api Key Delete"}}}}},"security":[{"HTTPBasic":[]}]}},"/users":{"get":{"summary":"Get Users","description":"List all users. Clients must send a valid X-API-Key header.","operationId":"get_users_users_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Response Get User